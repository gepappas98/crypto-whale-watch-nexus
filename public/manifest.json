{
  "name": "Whale Radar v9",
  "short_name": "WhaleRadar",
  "description": "AI-powered crypto whale tracking and market manipulation detection",
  "version": "9.0.0",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "any",
  "scope": "/",
  "id": "/",
  "categories": ["finance", "utilities", "trading"],
  "lang": "en",
  "dir": "ltr",
  
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  
  "screenshots": [
    {
      "src": "/screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Whale Radar Dashboard"
    },
    {
      "src": "/screenshots/mobile-view.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile Whale Tracking"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Start Scan",
      "short_name": "Scan",
      "description": "Start market manipulation scan",
      "url": "/?action=scan",
      "icons": [{ "src": "/icons/scan-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Portfolio",
      "short_name": "Portfolio",
      "description": "View your tracked portfolio",
      "url": "/?tab=portfolio",
      "icons": [{ "src": "/icons/portfolio-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Insider Risk",
      "short_name": "Risk",
      "description": "Check insider risk scanner",
      "url": "/?tab=insider",
      "icons": [{ "src": "/icons/risk-96x96.png", "sizes": "96x96" }]
    }
  ],
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "handle_links": "preferred",
  
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  
  "protocol_handlers": [
    {
      "protocol": "web+whale",
      "url": "/track?token=%s"
    }
  ],
  
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link"
    }
  },
  
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.whaleradar.android",
      "id": "app.whaleradar.android"
    }
  ],
  
  "prefer_related_applications": false
}
