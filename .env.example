# Whale Radar — example environment variables
# These are required ONLY if you self-host and want to use a custom
# Supabase Edge Function for the Hyperliquid cache. The default
# deployment talks to api.hyperliquid.xyz directly and needs nothing here.
#
# For Lovable deployments: do NOT use .env.local — set these in
# Project Settings → Environment Variables instead.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
